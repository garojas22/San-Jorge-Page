---
import Seccion from './Seccion.astro';
import { SITIO } from '../data/sitio.js';
---
<Seccion id="quienes-somos" titulo="Quiénes somos" fondo="suave">
  <div class="qs">
    <div class="qs__texto">
      {SITIO.historia.map((p) => <p>{p}</p>)}
      <p class="qs__mision">“{SITIO.mision}”</p>
    </div>
    <ul class="cifras" aria-label="La fundación en cifras">
      {SITIO.cifras.map((c) => (
        <li>
          <span class="cifras__valor">{c.valor}</span>
          <span class="cifras__texto">{c.texto}</span>
        </li>
      ))}
    </ul>
  </div>
</Seccion>

<style>
  .qs { display: flex; flex-wrap: wrap; gap: 1.75rem 3rem; align-items: center; }
  .qs__texto { flex: 1 1 30rem; min-width: 0; }
  .qs__texto p { max-width: 60ch; }
  .qs__mision { font-size: 1.25rem; font-weight: 700; line-height: 1.4; margin: 0; }
  .cifras {
    flex: 1 1 21rem;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    text-align: center;
  }
  .cifras li {
    display: flex;
    flex-direction: column;
    background: var(--sj-blanco);
    border-radius: 12px;
    padding: 1rem 0.375rem;
  }
  .cifras__valor { font-size: 1.875rem; font-weight: 800; line-height: 1; }
  .cifras__texto { margin-top: 0.375rem; font-size: 0.9375rem; color: var(--sj-gris); line-height: 1.3; }

  @media (min-width: 768px) {
    .qs__mision { font-size: 1.375rem; }
    .cifras { gap: 0.75rem; }
    .cifras li { padding: 1.5rem 0.5rem; border-radius: var(--radio-tarjeta); }
    .cifras__valor { font-size: 2.5rem; }
  }
</style>
