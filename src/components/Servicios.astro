---
import Seccion from './Seccion.astro';
import Icono from './Icono.astro';
import { SERVICIOS } from '../data/secciones.js';
---
<Seccion id="servicios" titulo="Servicios" intro="Además del almuerzo, el comedor ofrece:">
  <ul class="servicios">
    {SERVICIOS.map((s) => (
      <li>
        <span class="icono-circulo"><Icono nombre={s.icono} /></span>
        <div>
          <h3>{s.titulo}</h3>
          <p>{s.texto}</p>
        </div>
      </li>
    ))}
  </ul>
</Seccion>

<style>
  .servicios {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18.75rem), 1fr));
    gap: 1.25rem 2rem;
  }
  .servicios li { display: flex; gap: 0.875rem; align-items: flex-start; }
  .servicios h3 { margin: 0; }
  .servicios p { margin: 0; color: var(--sj-gris); font-size: var(--texto-chico); }
  @media (min-width: 768px) {
    .servicios { row-gap: 1.75rem; }
  }
</style>
