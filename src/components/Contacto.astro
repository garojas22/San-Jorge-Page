---
// Galería y contacto. Lo que falta de la fundación se ve como recuadro
// "pendiente" y desaparece al rellenar src/data/sitio.js.
import Seccion from './Seccion.astro';
import Icono from './Icono.astro';
import Pendiente from './Pendiente.astro';
import { SITIO } from '../data/sitio.js';
import { HORARIO } from '../data/programacion.js';
import { rangoHoras } from '../lib/fechas.js';
import { enlaceWhatsApp } from '../lib/whatsapp.js';

const c = SITIO.contacto;
const wa = enlaceWhatsApp(c.whatsapp);
---
<Seccion id="galeria" titulo="Galería">
  <div class="galeria" aria-hidden="true">
    {Array.from({ length: 6 }, () => <div class="galeria__hueco"></div>)}
  </div>
  <p class="nota">[9 a 12 fotos del comedor, con permiso de quienes aparecen]</p>
</Seccion>

<Seccion id="contacto" titulo="Contacto" sinTitulo>
  <div class="contacto">
    <div class="contacto__datos">
      <h2 id="titulo-contacto">Contacto</h2>
      <ul>
        <li>
          <Icono nombre="clock" />
          <div><strong>Horario</strong><br />{HORARIO.dias}, {rangoHoras(HORARIO.apertura, HORARIO.cierre)}</div>
        </li>
        <li>
          <Icono nombre="map-pin" />
          <div>
            <strong>Dirección</strong><br />
            {c.direccion ? c.direccion : <span class="nota-en-linea">[Dirección exacta]</span>}, La Victoria, Aragua
            {c.mapaUrl && <><br /><a href={c.mapaUrl} target="_blank" rel="noopener">Ver en Google Maps</a></>}
          </div>
        </li>
        <li>
          <Icono nombre="message-circle" />
          <div>
            <strong>WhatsApp</strong><br />
            {wa ? <a href={wa} target="_blank" rel="noopener">{c.whatsapp}</a> : <span class="nota-en-linea">[Número oficial]</span>}
          </div>
        </li>
        <li>
          <Icono nombre="camera" />
          <div>
            <strong>Instagram</strong><br />
            {c.instagram
              ? <a href={`https://instagram.com/${c.instagram}`} target="_blank" rel="noopener">@{c.instagram}</a>
              : <span class="nota-en-linea">[@usuario]</span>}
          </div>
        </li>
      </ul>
    </div>
    <div class="contacto__mapa">
      {c.mapaUrl
        ? <a class="contacto__abrir-mapa" href={c.mapaUrl} target="_blank" rel="noopener"><Icono nombre="map-pin" /> Abrir en Google Maps</a>
        : <Pendiente que="Mapa de Google" foto />}
    </div>
  </div>
</Seccion>

<style>
  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(30%, 10rem), 1fr));
    gap: 0.375rem;
  }
  .galeria__hueco { aspect-ratio: 1; border-radius: 8px; background: var(--sj-fondo-suave); }
  .nota { margin: 0.625rem 0 0; font-size: 0.9375rem; color: var(--sj-gris); }
  .nota-en-linea { color: var(--sj-gris); }

  .contacto {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2.5rem;
    border-top: 1px solid var(--sj-linea);
    padding-top: var(--espacio-seccion);
  }
  .contacto__datos { flex: 1 1 22rem; min-width: 0; }
  .contacto__datos h2 { margin-bottom: 1.25rem; }
  .contacto__datos ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .contacto__datos li { display: flex; gap: 0.75rem; align-items: flex-start; }
  .contacto__datos li :global(svg) { margin-top: 0.2rem; }
  .contacto__mapa { flex: 1 1 28rem; min-width: 0; }
  .contacto__mapa :global(.pendiente) { min-height: 10.5rem; }
  .contacto__abrir-mapa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 10.5rem;
    border-radius: var(--radio-tarjeta);
    background: var(--sj-fondo-suave);
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .galeria { grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); gap: 0.625rem; }
    .galeria__hueco { aspect-ratio: 4 / 3; border-radius: 10px; }
    .contacto__mapa :global(.pendiente) { min-height: 18.75rem; border-radius: var(--radio-grande); }
  }
</style>
