---
// Voces de San Jorge: texto y una foto o video de una presentación.
import Seccion from './Seccion.astro';
import Icono from './Icono.astro';
import Pendiente from './Pendiente.astro';
import { VOCES } from '../data/secciones.js';
---
<Seccion id="voces" fondo="suave" sinTitulo>
  <div class="voces">
    <div class="voces__texto">
      <div class="voces__titulo">
        <span class="icono-circulo icono-circulo--amarillo"><Icono nombre="music" /></span>
        <h2 id="titulo-voces">Voces de San Jorge</h2>
      </div>
      {VOCES.texto.map((p) => <p>{p}</p>)}
    </div>
    <div class="voces__media">
      <Pendiente que="Foto o video de una presentación" foto />
    </div>
  </div>
</Seccion>

<style>
  .voces { display: flex; flex-wrap: wrap; gap: 1.25rem 2.5rem; align-items: center; }
  .voces__texto { flex: 1 1 26rem; min-width: 0; }
  .voces__texto p { max-width: 52ch; }
  .voces__texto p:last-child { margin-bottom: 0; }
  .voces__titulo { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
  .voces__titulo h2 { margin: 0; }
  .voces__media { flex: 1 1 26rem; min-width: 0; }
  .voces__media :global(.pendiente) { background: var(--sj-blanco); min-height: 11.25rem; }
  @media (min-width: 768px) {
    .voces__media :global(.pendiente) { min-height: 17.5rem; border-radius: var(--radio-grande); }
  }
</style>
