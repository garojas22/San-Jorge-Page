---
// Encabezado blanco con el logo y una línea amarilla de 3 px debajo.
// Teléfono: logo + A+ + botón "Menú" que despliega la lista.
// Computadora (≥ 992 px): los enlaces se ven siempre, en una fila.
// Sin JavaScript el menú se ve siempre abierto: nada queda inaccesible.
import Icono from './Icono.astro';
import { SITIO } from '../data/sitio.js';
import { NAVEGACION } from '../data/navegacion.js';
import { HORARIO } from '../data/programacion.js';
import { rangoHoras } from '../lib/fechas.js';
---
<header class="encabezado">
  <div class="contenedor encabezado__fila">
    <a class="marca" href="/" aria-label={`${SITIO.nombre}, inicio`}>
      {SITIO.logo && <img class="marca__logo" src={SITIO.logo} alt="" width="48" height="45" />}
      <span class="marca__texto">
        <span class="marca__pre">Fundación</span>
        <span class="marca__nombre">San Jorge</span>
      </span>
    </a>

    <nav class="menu" id="menu-principal" aria-label="Principal">
      <ul>
        {NAVEGACION.map((n) => (
          <li class:list={{ 'menu__solo-telefono': n.soloMenu }}><a href={n.href}>{n.texto}</a></li>
        ))}
      </ul>
      <p class="menu__horario">Abierto de {HORARIO.dias.toLowerCase()}, {rangoHoras(HORARIO.apertura, HORARIO.cierre)}</p>
    </nav>

    <div class="encabezado__acciones">
      <button class="control" type="button" data-texto-grande aria-pressed="false">
        A+<span class="solo-lector"> Agrandar el texto</span>
      </button>
      <button
        class="control control--menu"
        type="button"
        data-menu-boton
        aria-expanded="false"
        aria-controls="menu-principal"
      >
        <span class="control__icono control__icono--abrir"><Icono nombre="menu" tam={20} /></span>
        <span class="control__icono control__icono--cerrar"><Icono nombre="x" tam={20} /></span>
        <span data-menu-texto>Menú</span>
      </button>
    </div>
  </div>
</header>

<style>
  .encabezado {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--sj-blanco);
    border-bottom: 3px solid var(--sj-amarillo);
  }
  .encabezado__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1rem;
    padding-block: 0.625rem;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--sj-negro);
    text-decoration: none;
    min-height: var(--toque-min);
  }
  .marca:hover { color: var(--sj-negro); }
  .marca__logo { width: 2.75rem; height: auto; }
  .marca__texto { display: flex; flex-direction: column; line-height: 1.1; }
  .marca__pre { font-size: 0.8125rem; color: var(--sj-gris); }
  .marca__nombre { font-size: 1.125rem; font-weight: 800; }

  .encabezado__acciones { display: flex; gap: 0.5rem; }
  .control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-width: var(--toque-min);
    height: var(--toque-min);
    padding: 0 0.875rem;
    border-radius: var(--radio-boton);
    border: 1px solid var(--sj-borde-control);
    background: var(--sj-blanco);
    color: var(--sj-negro);
    font-family: var(--fuente);
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
  }
  .control[aria-pressed='true'],
  .control--menu[aria-expanded='true'] {
    background: var(--sj-negro);
    border-color: var(--sj-negro);
    color: var(--sj-blanco);
  }
  .control--menu { display: none; } /* solo existe con JavaScript */
  :global(html.js) .control--menu { display: inline-flex; }
  .control__icono { display: inline-flex; }
  .control__icono--cerrar,
  .control--menu[aria-expanded='true'] .control__icono--abrir { display: none; }
  .control--menu[aria-expanded='true'] .control__icono--cerrar { display: inline-flex; }

  /* Menú del teléfono: lista grande, ocupa el ancho, debajo de la fila. */
  .menu { order: 3; flex-basis: 100%; }
  .menu ul { list-style: none; margin: 0; padding: 0.5rem 0 0; }
  .menu li { border-bottom: 1px solid var(--sj-linea); }
  .menu li:last-child { border-bottom: 0; }
  .menu a {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    font-size: 1.3125rem;
    font-weight: 700;
    text-decoration: none;
  }
  .menu__horario {
    margin: 0.5rem calc(-1 * var(--margen-lateral)) -0.625rem;
    padding: 1rem var(--margen-lateral);
    background: var(--sj-fondo-suave);
    color: var(--sj-gris);
    font-size: var(--texto-chico);
  }
  /* Con JavaScript, el menú del teléfono se pliega detrás del botón. */
  :global(html.js) .menu:not(.abierto) { display: none; }

  @media (min-width: 992px) {
    .encabezado__fila { flex-wrap: nowrap; }
    :global(html.js) .control--menu { display: none; }
    .menu,
    :global(html.js) .menu:not(.abierto) {
      display: block;
      order: 0;
      flex-basis: auto;
      margin-left: auto;
    }
    .menu ul { display: flex; padding: 0; }
    .menu li { border: 0; }
    .menu__solo-telefono, .menu__horario { display: none; }
    .menu a { min-height: var(--toque-min); padding: 0 0.75rem; font-size: 1rem; }
    .marca__logo { width: 3.25rem; }
    .marca__pre { font-size: 0.875rem; }
    .marca__nombre { font-size: 1.25rem; }
  }
</style>
