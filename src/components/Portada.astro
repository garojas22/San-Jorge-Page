---
// Portada. Teléfono: foto arriba, texto y botones debajo.
// Computadora: texto a la izquierda, foto a la derecha.
// Sin foto todavía, un recuadro "pendiente" ocupa su lugar.
import Boton from './Boton.astro';
import Pendiente from './Pendiente.astro';
import { SITIO } from '../data/sitio.js';
---
<section class="portada contenedor" aria-labelledby="titulo-portada">
  <div class="portada__foto">
    {SITIO.fotoPortada
      ? <img src={SITIO.fotoPortada} alt="Patio del comedor de la Fundación San Jorge con sus murales" width="900" height="600" fetchpriority="high" />
      : <Pendiente que="Foto del patio con los murales" foto />}
  </div>
  <div class="portada__texto">
    <h1 id="titulo-portada">{SITIO.lema}</h1>
    <p class="portada__sub">
      Comedor para adultos mayores en La Victoria, Aragua.
      Lunes a viernes, de 8:00&nbsp;a.m. a 2:00&nbsp;p.m.
    </p>
    <div class="portada__botones">
      <Boton href="#hoy">Ver actividades de hoy</Boton>
      <Boton href="#como-ayudar" variante="secundario">Cómo ayudar</Boton>
    </div>
  </div>
</section>

<style>
  .portada {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 1.25rem 2rem;
  }
  .portada__foto { height: 12.5rem; }
  .portada__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radio-tarjeta);
  }
  .portada__foto :global(.pendiente) { height: 100%; }
  .portada h1 { margin-bottom: 0.5rem; }
  .portada__sub { color: var(--sj-gris); margin-bottom: 1.5rem; max-width: 32ch; }
  .portada__botones { display: flex; flex-direction: column; gap: 0.625rem; }

  @media (min-width: 768px) {
    .portada {
      flex-direction: row-reverse;
      align-items: center;
      gap: 2.5rem;
      padding-block: 3.5rem 2.5rem;
    }
    .portada__foto, .portada__texto { flex: 1 1 0; min-width: 0; }
    .portada__foto { height: 22.5rem; }
    .portada__foto :global(.pendiente), .portada__foto img { border-radius: var(--radio-grande); }
    .portada__sub { font-size: 1.25rem; }
    .portada__botones { flex-direction: row; flex-wrap: wrap; gap: 0.75rem; }
  }
</style>
