---
// Íconos de línea (Lucide) incrustados como SVG: cero peticiones extra.
// Toman el color del texto que los rodea (stroke="currentColor").
// Para agregar uno: importarlo aquí y sumarlo al objeto ICONOS.
import activity from 'lucide-static/icons/activity.svg?raw';
import calendar from 'lucide-static/icons/calendar.svg?raw';
import camera from 'lucide-static/icons/camera.svg?raw';
import chevronLeft from 'lucide-static/icons/chevron-left.svg?raw';
import clock from 'lucide-static/icons/clock.svg?raw';
import handHelping from 'lucide-static/icons/hand-helping.svg?raw';
import heart from 'lucide-static/icons/heart.svg?raw';
import mapPin from 'lucide-static/icons/map-pin.svg?raw';
import menu from 'lucide-static/icons/menu.svg?raw';
import messageCircle from 'lucide-static/icons/message-circle.svg?raw';
import music from 'lucide-static/icons/music.svg?raw';
import packageIcon from 'lucide-static/icons/package.svg?raw';
import pill from 'lucide-static/icons/pill.svg?raw';
import scissors from 'lucide-static/icons/scissors.svg?raw';
import share2 from 'lucide-static/icons/share-2.svg?raw';
import smile from 'lucide-static/icons/smile.svg?raw';
import sparkles from 'lucide-static/icons/sparkles.svg?raw';
import users from 'lucide-static/icons/users.svg?raw';
import x from 'lucide-static/icons/x.svg?raw';

const ICONOS = {
  activity, calendar, camera, 'chevron-left': chevronLeft, clock,
  'hand-helping': handHelping, heart, 'map-pin': mapPin, menu,
  'message-circle': messageCircle, music, package: packageIcon, pill,
  scissors, 'share-2': share2, smile, sparkles, users, x,
};

const { nombre, tam = 24, clase = '' } = Astro.props;
const crudo = ICONOS[nombre];
if (!crudo) throw new Error(`Ícono desconocido: "${nombre}". Agrégalo en Icono.astro.`);

// Quita el comentario de licencia, fija tamaño y clase; aria-hidden porque
// el ícono siempre acompaña a un texto que ya dice lo mismo.
const svg = crudo
  .replace(/<!--[\s\S]*?-->/, '')
  .replace(/class="[^"]*"/, `class="icono ${clase}"`)
  .replace(/width="24"/, `width="${tam}"`)
  .replace(/height="24"/, `height="${tam}"`)
  .replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<Fragment set:html={svg} />
