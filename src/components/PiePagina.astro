---
import { SITIO } from '../data/sitio.js';
import { HORARIO } from '../data/programacion.js';
import { rangoHoras } from '../lib/fechas.js';
---
<footer class="pie">
  <div class="contenedor pie__fila">
    <div class="pie__marca">
      {SITIO.logo && <img src={SITIO.logo} alt="Logo de la Fundación San Jorge" width="72" height="67" loading="lazy" />}
      <div>
        <p class="pie__nombre">{SITIO.nombre}</p>
        <p class="pie__frase">{SITIO.frase}</p>
      </div>
    </div>
    <div class="pie__datos">
      <p>{HORARIO.dias}, {rangoHoras(HORARIO.apertura, HORARIO.cierre)}</p>
      <p>{SITIO.contacto.direccion ? `${SITIO.contacto.direccion}, ` : ''}La Victoria, Aragua</p>
    </div>
    <p class="pie__credito">
      Sitio desarrollado como Servicio Comunitario de la Universidad Bicentenaria de Aragua (UBA).
    </p>
  </div>
</footer>

<style>
  .pie {
    background: var(--sj-fondo-suave);
    border-top: 3px solid var(--sj-amarillo);
    padding-block: 2rem;
    font-size: var(--texto-chico);
  }
  .pie p { margin: 0; }
  .pie__fila { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem 3rem; }
  .pie__marca { display: flex; align-items: center; gap: 0.75rem; }
  /* El logo provisional tiene fondo blanco: "multiply" lo funde con el gris. */
  .pie__marca img { width: 4rem; mix-blend-mode: multiply; }
  .pie__nombre { font-weight: 800; font-size: 1.1875rem; line-height: 1.3; }
  .pie__frase { color: var(--sj-gris); }
  .pie__datos { line-height: 1.5; }
  .pie__credito {
    flex-basis: 100%;
    font-size: var(--texto-mini);
    color: var(--sj-gris);
    border-top: 1px solid var(--sj-linea);
    padding-top: 0.875rem;
  }
  @media (min-width: 768px) {
    .pie { padding-block: 2.5rem 2rem; }
    .pie__marca img { width: 4.5rem; }
  }
</style>
