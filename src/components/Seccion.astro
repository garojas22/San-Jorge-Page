---
// Envoltorio común de cada sección: mismo espaciado y mismo título en toda
// la página. `fondo` alterna blanco y gris suave para separar secciones
// sin usar líneas ni colores fuertes.
// `sinTitulo`: la sección dibuja su propio título (debe usar id="titulo-<id>").
const { id, titulo, intro, fondo = 'blanco', sinTitulo = false } = Astro.props;
---
<section id={id} class:list={['seccion', `seccion--${fondo}`]} aria-labelledby={`titulo-${id}`}>
  <div class="contenedor">
    {!sinTitulo && (
      <h2 id={`titulo-${id}`} class:list={['seccion__titulo', { 'seccion__titulo--con-intro': intro }]}>{titulo}</h2>
    )}
    {!sinTitulo && intro && <p class="seccion__intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .seccion { padding-block: var(--espacio-seccion); }
  .seccion--blanco { background: var(--sj-blanco); }
  .seccion--suave { background: var(--sj-fondo-suave); }
  .seccion__titulo { margin-bottom: 1.25rem; }
  .seccion__titulo--con-intro { margin-bottom: 0.25rem; }
  .seccion__intro { color: var(--sj-gris); margin-bottom: 1.5rem; max-width: 60ch; }
</style>
