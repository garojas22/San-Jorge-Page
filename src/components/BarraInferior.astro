---
// Barra fija abajo, solo en teléfono: lo que más se busca, a un toque del pulgar.
// Sin número de WhatsApp todavía, el tercer botón lleva a Contacto.
// En computadora: botón redondo de WhatsApp abajo a la derecha (si hay número).
import Icono from './Icono.astro';
import { SITIO } from '../data/sitio.js';
import { enlaceWhatsApp } from '../lib/whatsapp.js';
const wa = enlaceWhatsApp(SITIO.contacto.whatsapp, 'Hola, quisiera información sobre la Fundación San Jorge.');
---
<nav class="barra" aria-label="Accesos rápidos">
  <a href="/#programacion"><Icono nombre="calendar" tam={22} /><span>Actividades</span></a>
  <a href="/#como-ayudar"><Icono nombre="heart" tam={22} /><span>Ayudar</span></a>
  {wa
    ? <a href={wa} target="_blank" rel="noopener" class="barra__wa"><Icono nombre="message-circle" tam={22} /><span>WhatsApp</span></a>
    : <a href="/#contacto"><Icono nombre="map-pin" tam={22} /><span>Contacto</span></a>}
</nav>
{wa && (
  <a class="flotante" href={wa} target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
    <Icono nombre="message-circle" tam={28} />
  </a>
)}

<style>
  .barra {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: var(--sj-blanco);
    border-top: 1px solid var(--sj-linea);
    box-shadow: 0 -2px 10px rgb(28 28 28 / 0.05);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .barra a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.125rem;
    min-height: var(--alto-barra-inferior);
    color: var(--sj-negro);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--texto-mini);
  }
  .barra .barra__wa { color: var(--sj-verde); }
  /* Que la barra no tape el final de la página. */
  :global(body) { padding-bottom: calc(var(--alto-barra-inferior) + env(safe-area-inset-bottom)); }

  .flotante { display: none; }

  @media (min-width: 768px) {
    .barra { display: none; }
    :global(body) { padding-bottom: 0; }
    .flotante {
      display: grid;
      place-items: center;
      position: fixed;
      right: 1.5rem;
      bottom: 1.5rem;
      z-index: 40;
      width: 3.75rem;
      height: 3.75rem;
      border-radius: 50%;
      background: var(--sj-verde);
      color: var(--sj-blanco);
      box-shadow: var(--sombra-flotante);
    }
    .flotante:hover { color: var(--sj-blanco); filter: brightness(0.95); }
  }
</style>
