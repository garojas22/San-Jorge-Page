---
// Botón-enlace. Variantes del diseño aprobado:
//   principal          amarillo con texto negro (UNA por pantalla, la acción más buscada)
//   secundario         contorno negro
//   whatsapp           verde sólido (la acción principal de una sección de ayuda)
//   whatsapp-contorno  contorno verde (varios botones de WhatsApp juntos)
// `ancho` lo estira a todo el ancho (teléfono). `externo` abre en otra pestaña.
import Icono from './Icono.astro';
const { href, variante = 'principal', externo = false, icono, ancho = false } = Astro.props;
---
<a
  class:list={['boton', `boton--${variante}`, { 'boton--ancho': ancho }]}
  href={href}
  {...(externo ? { target: '_blank', rel: 'noopener' } : {})}
>
  {icono && <Icono nombre={icono} tam={20} />}
  <span><slot /></span>
</a>

<style>
  .boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.25rem;
    padding: 0.5rem 1.5rem;
    border-radius: var(--radio-boton);
    font-weight: 800;
    font-size: var(--texto-base);
    line-height: 1.2;
    text-decoration: none;
    text-align: center;
  }
  .boton--ancho { display: flex; width: 100%; }
  .boton--principal { background: var(--sj-amarillo); color: var(--sj-negro); }
  .boton--secundario { box-shadow: inset 0 0 0 1.5px var(--sj-negro); color: var(--sj-negro); font-weight: 700; }
  .boton--whatsapp { background: var(--sj-verde); color: var(--sj-blanco); }
  .boton--whatsapp-contorno {
    box-shadow: inset 0 0 0 1.5px var(--sj-verde);
    color: var(--sj-verde);
    min-height: var(--toque-min);
    font-size: 1.0625rem;
  }
  .boton:hover { filter: brightness(0.95); color: inherit; }
  .boton--principal:hover, .boton--secundario:hover { color: var(--sj-negro); }
  .boton--whatsapp:hover { color: var(--sj-blanco); }
  .boton--whatsapp-contorno:hover { color: var(--sj-verde); background: var(--sj-fondo-suave); }
</style>
