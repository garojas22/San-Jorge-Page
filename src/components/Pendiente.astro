---
// Marca un dato que la fundación todavía no ha entregado. Aparece solo
// cuando el valor en src/data/ es null; al rellenarlo, desaparece sola.
// `foto` lo dibuja como un recuadro alto en el lugar de la foto que falta;
// el alto lo decide la sección que lo contiene.
const { que, foto = false } = Astro.props;
---
{foto
  ? <div class="pendiente pendiente--foto"><span>[{que}]</span></div>
  : <p class="pendiente"><strong>Pendiente:</strong> {que}</p>}

<style>
  .pendiente {
    border: 1px dashed var(--sj-borde-pendiente);
    border-radius: var(--radio-boton);
    padding: 0.6rem 0.9rem;
    color: var(--sj-gris);
    background: var(--sj-blanco);
    font-size: var(--texto-chico);
    margin: 0 0 1rem;
  }
  .pendiente--foto {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 12.5rem;
    border-radius: var(--radio-tarjeta);
    background: var(--sj-fondo-suave);
    margin: 0;
  }
</style>
