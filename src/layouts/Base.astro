---
// Plantilla de todas las páginas: <head> con SEO y Open Graph, encabezado,
// pie y barra inferior. Una página solo aporta su <main>.
// Una sola familia tipográfica (diseño aprobado el 2026-10-28), servida
// desde el propio sitio: sin depender de Google Fonts ni gastar otra conexión.
import '@fontsource/nunito-sans/latin-400.css';
import '@fontsource/nunito-sans/latin-700.css';
import '@fontsource/nunito-sans/latin-800.css';
import '../styles/variables.css';
import '../styles/base.css';
import Encabezado from '../components/Encabezado.astro';
import PiePagina from '../components/PiePagina.astro';
import BarraInferior from '../components/BarraInferior.astro';
import { SITIO } from '../data/sitio.js';

const {
  titulo = SITIO.tituloSeo,
  descripcion = SITIO.descripcionSeo,
  imagen = '/og.jpg',
  noIndexar = false,
  jsonLd = null,
} = Astro.props;

const urlCanonica = new URL(Astro.url.pathname, Astro.site);
const urlImagen = new URL(imagen, Astro.site);
---
<!doctype html>
<html lang="es-VE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />
    {noIndexar && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph: cómo se ve el enlace al compartirlo por WhatsApp o Instagram -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Se ejecuta antes de pintar: aplica el texto grande guardado sin
         que la página "salte", y marca que hay JavaScript disponible. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('sj-texto-grande') === '1') {
          document.documentElement.classList.add('texto-grande');
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="saltar-contenido" href="#contenido">Saltar al contenido</a>
    <Encabezado />
    <main id="contenido">
      <slot />
    </main>
    <PiePagina />
    <BarraInferior />
    <script>
      import '../scripts/cliente.js';
    </script>
  </body>
</html>
