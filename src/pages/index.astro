---
// Portada: una sola página larga. El orden sigue el brief: "Hoy" va justo
// después de la portada porque es lo que más buscan las familias.
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import Hoy from '../components/Hoy.astro';
import QuienesSomos from '../components/QuienesSomos.astro';
import Programacion from '../components/Programacion.astro';
import Eventos from '../components/Eventos.astro';
import Servicios from '../components/Servicios.astro';
import Voces from '../components/Voces.astro';
import Ayuda from '../components/Ayuda.astro';
import Contacto from '../components/Contacto.astro';
import { SITIO } from '../data/sitio.js';

// Datos estructurados para Google: la fundación como organización sin fines de lucro.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: SITIO.nombre,
  slogan: SITIO.lema,
  url: Astro.site?.toString(),
  areaServed: SITIO.ubicacion,
  ...(SITIO.contacto.direccion && {
    address: { '@type': 'PostalAddress', streetAddress: SITIO.contacto.direccion, addressLocality: 'La Victoria', addressRegion: 'Aragua', addressCountry: 'VE' },
  }),
};
---
<Base jsonLd={jsonLd}>
  <Portada />
  <Hoy />
  <QuienesSomos />
  <Programacion />
  <Eventos />
  <Servicios />
  <Voces />
  <Ayuda />
  <Contacto />
</Base>
