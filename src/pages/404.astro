---
import Base from '../layouts/Base.astro';
import Boton from '../components/Boton.astro';
---
<Base titulo="Página no encontrada | Fundación San Jorge" noIndexar>
  <section class="contenedor no-encontrada">
    <h1>Esta página no existe</h1>
    <p>Puede que el evento ya haya pasado o que el enlace esté incompleto.</p>
    <Boton href="/">Ir al inicio</Boton>
  </section>
</Base>

<style>
  .no-encontrada { padding-block: 4rem; }
</style>
