---
// Una página por evento, generada en la compilación. Por ser HTML real
// (no armado con JavaScript), al compartir el enlace por WhatsApp se ve
// el título y la descripción de ESTE evento.
import Base from '../../layouts/Base.astro';
import EtiquetaTipo from '../../components/EtiquetaTipo.astro';
import Boton from '../../components/Boton.astro';
import Icono from '../../components/Icono.astro';
import Pendiente from '../../components/Pendiente.astro';
import { cargarEventos } from '../../fuentes/eventos.js';
import { fechaLarga, rangoHoras } from '../../lib/fechas.js';
import { enlaceWhatsApp } from '../../lib/whatsapp.js';
import { SITIO } from '../../data/sitio.js';

export async function getStaticPaths() {
  const eventos = await cargarEventos();
  return eventos.filter((e) => e.publicado).map((e) => ({ params: { id: e.id }, props: { evento: e } }));
}

const { evento: e } = Astro.props;
const larga = fechaLarga(e.fecha);
const diaTexto = `${larga[0].toUpperCase()}${larga.slice(1)}`;
const horas = rangoHoras(e.horaInicio, e.horaFin);
const cuando = `${larga}, ${horas}`;
const url = new URL(Astro.url.pathname, Astro.site).toString();

// Compartir no necesita el número de la fundación: abre WhatsApp para que
// la persona elija a quién mandarlo.
const compartir = `https://wa.me/?text=${encodeURIComponent(`${e.titulo}, ${cuando}. ${url}`)}`;
const preguntar = enlaceWhatsApp(SITIO.contacto.whatsapp, `Hola, quisiera información sobre el evento "${e.titulo}" del ${larga}.`);

// Los eventos de ejemplo no se anuncian a Google.
const jsonLd = e.ejemplo ? null : {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.titulo,
  description: e.descripcion,
  startDate: `${e.fecha}T${e.horaInicio}:00-04:00`,
  ...(e.horaFin && { endDate: `${e.fecha}T${e.horaFin}:00-04:00` }),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: e.lugar, address: SITIO.contacto.direccion ?? SITIO.ubicacion },
  organizer: { '@type': 'NGO', name: SITIO.nombre, url: Astro.site?.toString() },
  isAccessibleForFree: true,
};
---
<Base
  titulo={`${e.titulo} | ${SITIO.nombre}`}
  descripcion={`${cuando}. ${e.descripcion}`}
  imagen={e.foto ?? '/og.jpg'}
  noIndexar={e.ejemplo}
  jsonLd={jsonLd}
>
  <article class="detalle contenedor">
    <a href="/#eventos" class="detalle__volver"><Icono nombre="chevron-left" tam={20} />Todos los eventos</a>

    <p class="detalle__etiquetas">
      <EtiquetaTipo tipo={e.tipo} />
      {e.ejemplo && <span class="detalle__ejemplo">Evento de ejemplo</span>}
    </p>
    <h1>{e.titulo}</h1>

    <div class="detalle__foto">
      {e.foto
        ? <img src={e.foto} alt="" width="900" height="600" />
        : <Pendiente que="Foto del evento, opcional" foto />}
    </div>

    <dl class="detalle__datos">
      <div>
        <Icono nombre="calendar" tam={22} />
        <div><dt>Cuándo</dt><dd>{diaTexto}<br />{horas}</dd></div>
      </div>
      <div>
        <Icono nombre="map-pin" tam={22} />
        <div><dt>Dónde</dt><dd>{e.lugar}</dd></div>
      </div>
      {e.queLlevar && (
        <div>
          <Icono nombre="package" tam={22} />
          <div><dt>Qué llevar</dt><dd>{e.queLlevar}</dd></div>
        </div>
      )}
      {e.contacto && (
        <div>
          <Icono nombre="message-circle" tam={22} />
          <div><dt>Contacto</dt><dd>{e.contacto}</dd></div>
        </div>
      )}
    </dl>

    <p class="detalle__descripcion">{e.descripcion}</p>

    <div class="detalle__botones">
      <Boton href={compartir} variante="whatsapp" externo icono="share-2">Compartir por WhatsApp</Boton>
      {preguntar && <Boton href={preguntar} variante="secundario" externo>Preguntar a la fundación</Boton>}
    </div>
  </article>
</Base>

<style>
  .detalle { max-width: 46rem; padding-block: 0.75rem var(--espacio-seccion); }
  .detalle__volver {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: var(--toque-min);
    font-weight: 700;
    font-size: var(--texto-chico);
    text-decoration: none;
  }
  .detalle__etiquetas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.5rem 0;
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--sj-gris);
  }
  .detalle__ejemplo { border: 1px dashed var(--sj-gris-medio); border-radius: 999px; padding: 0 0.5rem; }
  .detalle h1 { font-size: 1.875rem; line-height: 1.2; margin-bottom: 1.25rem; }
  .detalle__foto { margin-bottom: 1.25rem; }
  .detalle__foto img { width: 100%; border-radius: var(--radio-tarjeta); }

  .detalle__datos {
    margin: 0 0 1.25rem;
    border: 1px solid var(--sj-linea);
    border-radius: var(--radio-tarjeta);
    overflow: hidden;
  }
  .detalle__datos > div {
    display: flex;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--sj-linea);
  }
  .detalle__datos > div:last-child { border-bottom: 0; }
  .detalle__datos :global(svg) { margin-top: 0.2rem; }
  .detalle__datos dt { font-size: var(--texto-mini); font-weight: 700; color: var(--sj-gris); }
  .detalle__datos dd { margin: 0; font-weight: 700; }

  .detalle__descripcion { margin-bottom: 1.5rem; }
  .detalle__botones { display: flex; flex-direction: column; gap: 0.625rem; }

  @media (min-width: 768px) {
    .detalle { padding-top: 1.5rem; }
    .detalle h1 { font-size: 2.5rem; }
    .detalle__botones { flex-direction: row; flex-wrap: wrap; }
  }
</style>
